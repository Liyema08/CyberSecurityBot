<Window x:Class="CyberSecurityBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YEMA-CYBER Security Bot" 
        Height="650" 
        Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E"
        ResizeMode="CanResizeWithGrip">

    <!-- =============================================== -->
    <!-- WINDOW RESOURCES - Defines styles for chat bubbles -->
    <!-- =============================================== -->
    <Window.Resources>

        <!-- Style for USER messages (right/blue side) -->
        <Style x:Key="UserBubble" TargetType="Border">
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="50,5,10,5"/>
        </Style>

        <!-- Style for BOT messages (left/darker side) -->
        <Style x:Key="BotBubble" TargetType="Border">
            <Setter Property="Background" Value="#0F3460"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="10,5,50,5"/>
        </Style>

    </Window.Resources>

    <!-- =============================================== -->
    <!-- MAIN GRID - Divides window into 4 rows -->
    <!-- =============================================== -->
    <Grid Margin="10">

        <!-- Row 0: Header (ASCII Art) -->
        <!-- Row 1: Commands Banner (NEW for POE) -->
        <!-- Row 2: Chat Display Area -->
        <!-- Row 3: Input Area -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- =============================================== -->
        <!-- ROW 0: ASCII ART HEADER -->
        <!-- =============================================== -->
        <Border Grid.Row="0" 
                Background="#0F3460" 
                CornerRadius="10" 
                Padding="15" 
                Margin="0,0,0,5">
            <TextBlock x:Name="AsciiArtBlock" 
                       Text="YEMA-CYBER SECURITY BOT" 
                       FontFamily="Consolas" 
                       FontSize="12" 
                       FontWeight="Bold" 
                       Foreground="#00FF00" 
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- =============================================== -->
        <!-- ROW 1: COMMANDS BANNER (POE Feature) -->
        <!-- =============================================== -->
        <Border Grid.Row="1" 
                Background="#16213E" 
                CornerRadius="10" 
                Padding="8" 
                Margin="0,0,0,5">
            <TextBlock Text="Commands: Add task: [title] | Show tasks | Complete task [id] | Delete task [id] | Start quiz | Activity log | Help"
                       Foreground="#00FF00" 
                       FontSize="11" 
                       TextWrapping="Wrap" 
                       TextAlignment="Center"
                       FontFamily="Segoe UI"/>
        </Border>

        <!-- =============================================== -->
        <!-- ROW 2: CHAT DISPLAY AREA -->
        <!-- =============================================== -->
        <ListBox x:Name="ChatDisplay" 
                 Grid.Row="2" 
                 Background="#1A1A2E" 
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <!-- Template for each chat message -->
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{Binding Style}">
                        <TextBlock Text="{Binding Message}" 
                                   TextWrapping="Wrap" 
                                   Foreground="White" 
                                   FontSize="14"
                                   FontFamily="Segoe UI"/>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <!-- =============================================== -->
        <!-- ROW 3: INPUT AREA (TextBox + Send Button) -->
        <!-- =============================================== -->
        <Border Grid.Row="3" 
                Background="#16213E" 
                CornerRadius="10" 
                Padding="10" 
                Margin="0,10,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Text box for user to type -->
                <TextBox x:Name="UserInput" 
                         Grid.Column="0" 
                         Background="#0F3460" 
                         Foreground="White" 
                         FontSize="14"
                         Padding="12,10"
                         BorderThickness="0"
                         FontFamily="Segoe UI"
                         KeyDown="UserInput_KeyDown"/>

                <!-- Send button -->
                <Button x:Name="SendButton" 
                        Grid.Column="1" 
                        Content="SEND" 
                        Width="80" 
                        Height="40" 
                        Margin="10,0,0,0"
                        Background="#00FF00" 
                        Foreground="#1A1A2E"
                        FontWeight="Bold"
                        FontSize="12"
                        Cursor="Hand"
                        Click="SendButton_Click"/>
            </Grid>

        </Border>

    </Grid>
</Window>